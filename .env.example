# Public/runtime configuration
APP_ENV=development
APP_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=
CORS_ORIGINS=http://localhost:3000

# Keep the local demo safe. Integrations stay disabled until configured.
DEMO_MODE=true

# GitHub webhook & API
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# OpenAI Intelligence
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
DEFAULT_CONTENT_FORMATS=image

# Kapso WhatsApp API
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# LinkedIn OAuth & Posts API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_API_VERSION=202608

# Token Encryption
TOKEN_ENCRYPTION_KEY=
# Optional dedicated signing key for HttpOnly sessions; otherwise TOKEN_ENCRYPTION_KEY is used.
SESSION_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8000
DEFAULT_USER_PHONE=+51999888777
