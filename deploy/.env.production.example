# Copy to deploy/.env.production on the VPS. Never commit the real file.
APP_ENV=production
APP_URL=https://laborin.meowlab.tech
CONVEX_URL=
CORS_ORIGINS=https://laborin.meowlab.tech
DEMO_MODE=true
LINKEDIN_API_VERSION=202608
# Optional dedicated signing key. If empty, the backend derives one from TOKEN_ENCRYPTION_KEY.
SESSION_SECRET=
GITHUB_WEBHOOK_SECRET=

# Used only while building the public Web bundle.
NEXT_PUBLIC_CONVEX_URL=

# OpenAI is used only after the user opens the WhatsApp conversation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
DEFAULT_CONTENT_FORMATS=image
