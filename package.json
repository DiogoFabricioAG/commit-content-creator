{
  "name": "proof-of-work",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:web": "pnpm --filter @proof-of-work/web dev",
    "dev:convex": "pnpm --filter @proof-of-work/convex dev",
    "dev:backend": "uv run uvicorn app.main:app --app-dir apps/backend --reload --port 8000",
    "lint:web": "pnpm --filter @proof-of-work/web lint",
    "typecheck:web": "pnpm --filter @proof-of-work/web typecheck",
    "typecheck:convex": "pnpm --filter @proof-of-work/convex typecheck",
    "test:backend": "uv run pytest",
    "lint": "pnpm lint:web && uv run ruff check apps/backend",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:convex && uv run pyright apps/backend",
    "test": "pnpm test:backend",
    "build:web": "pnpm --filter @proof-of-work/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:web"
  }
}
